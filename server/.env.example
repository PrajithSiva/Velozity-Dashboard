NODE_ENV=development
PORT=4000

# Local docker-compose Postgres. For production, point this at a managed
# PostgreSQL instance (see README "Deployment Architecture").
DATABASE_URL=postgresql://velozity:velozity@localhost:5432/velozity?schema=public

# Generate real secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

CLIENT_URL=http://localhost:5173
# COOKIE_DOMAIN=yourdomain.com
